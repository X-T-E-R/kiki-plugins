{
  "name": "kiki-pet",
  "version": "0.1.0",
  "description": "An isolated native desktop companion that reacts to Kiki tasks, imports Codex pets and carries a pet-making skill.",
  "license": "GPL-3.0-or-later",
  "skills": "./skills",
  "interface": {
    "displayName": "Desktop Pet",
    "shortDescription": "A companion for your Kiki work"
  },
  "x-kiki": {
    "engines": {
      "kiki": "^0.4.0"
    },
    "entry": "./entry.mjs",
    "activation": "app",
    "permissions": {
      "fs": "outside",
      "net": [
        "https://*"
      ],
      "exec": [
        "kiki-pet-runtime"
      ],
      "uiPanel": true
    },
    "panels": [
      {
        "schemaVersion": 1,
        "id": "pet",
        "label": "Desktop Pet",
        "slot": "workspace",
        "path": "./lib/panel/index.html",
        "assets": [
          "./lib/panel/panel.js",
          "./lib/panel/style.css"
        ]
      }
    ],
    "settings": {
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "properties": {
          "autoStart": {
            "type": "boolean",
            "title": "Start pet when enabled",
            "default": true
          }
        }
      }
    },
    "tools": [
      {
        "schemaVersion": 1,
        "name": "pet_control",
        "description": "Control the isolated Kiki desktop pet: inspect state, start or recover, pause, resize, play an animation, show a short text bubble, or focus the session it is reacting to. Never put prompt content or secrets in a bubble.",
        "parameters": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "state",
                "start",
                "stop",
                "settings",
                "select",
                "action",
                "say",
                "focus"
              ]
            },
            "id": {
              "type": "string"
            },
            "animationId": {
              "type": "string"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 10000
            },
            "text": {
              "type": "string",
              "maxLength": 160
            },
            "ttlMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 10000
            },
            "scale": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2.5
            },
            "paused": {
              "type": "boolean"
            },
            "reducedMotion": {
              "type": "boolean"
            },
            "autonomousWalking": {
              "type": "boolean"
            },
            "hoverPause": {
              "type": "boolean"
            },
            "idleSelfPlay": {
              "type": "boolean"
            },
            "eventReactions": {
              "type": "boolean"
            },
            "eventBubbles": {
              "type": "boolean"
            },
            "bubbleTtlMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 10000
            }
          },
          "additionalProperties": false,
          "required": [
            "operation"
          ]
        },
        "accesses": [
          {
            "kind": "all"
          }
        ]
      },
      {
        "schemaVersion": 1,
        "name": "pet_import_local",
        "description": "Import a Codex pet directory, pet.json, spritesheet.webp, ZIP or .petpack from a workspace-relative path or an approved absolute path. Only image/metadata files are read; scripts inside a package are never run. Source licenses and notices are retained.",
        "parameters": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "author": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "read",
            "path": "$.source",
            "recursive": true
          }
        ]
      },
      {
        "schemaVersion": 1,
        "name": "pet_import_url",
        "description": "Import a user-chosen public HTTPS desktop pet detail or download URL. Supports OpenPets, Awesome Codex Pet/codexpet.top, Petdex, Codex Pets, Chen .petpack and public spritesheet pages. Retains source/asset terms; unknown terms are not permission to redistribute. No scripts, login bypass or publishing.",
        "parameters": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "author": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "source"
          ]
        },
        "accesses": [
          {
            "kind": "all"
          }
        ]
      }
    ]
  }
}
