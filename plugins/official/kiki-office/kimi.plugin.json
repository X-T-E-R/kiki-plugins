{
  "name": "kiki-office",
  "version": "0.2.0",
  "description": "Create, inspect, edit, validate and preview Word, Excel and PowerPoint files locally with pinned OfficeCLI.",
  "license": "MIT",
  "icon": "./icon.svg",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kiki Office Suite",
    "shortDescription": "Create and edit local .docx, .xlsx and .pptx files"
  },
  "x-kiki": {
    "engines": {
      "kiki": "^0.4.0"
    },
    "entry": "./entry.mjs",
    "permissions": {
      "fs": "outside",
      "exec": [
        "officecli"
      ]
    },
    "prerequisites": {
      "schemaVersion": 1,
      "items": [
        {
          "id": "officecli",
          "kind": "executable",
          "required": true,
          "executionHost": "plugin-runtime",
          "version": "1.0.163",
          "setting": "officecliPath",
          "capabilityImpact": [
            "office-tools"
          ]
        }
      ]
    },
    "settings": {
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "properties": {
          "officecliPath": {
            "type": "string",
            "title": "OfficeCLI executable",
            "description": "Optional path to the pinned, compatible OfficeCLI binary."
          }
        }
      }
    },
    "tools": [
      {
        "schemaVersion": 1,
        "name": "office_create",
        "description": "Create a new blank docx, xlsx or pptx. Use before adding content; never overwrites an existing file. The pinned OfficeCLI binary must already be installed.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "write",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_get",
        "description": "Read a node at an exact semantic path as bounded structured JSON. Use after a text overview to locate paragraphs, cells or shapes; depth is capped at 3.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "path": {
              "type": "string"
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "required": [
            "file",
            "path"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "read",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_query",
        "description": "Find nodes matching an OfficeCLI selector. Returns bounded JSON by default, or compact one-line listings when compact=true (with optional fields for docx/pptx).",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "selector": {
              "type": "string"
            },
            "find": {
              "type": "string"
            },
            "compact": {
              "type": "boolean"
            },
            "fields": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "selector"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "read",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_set",
        "description": "Modify properties or replace matched text at a semantic path. Use on an existing document; specify props (flat map or [\"key=value\"] list) or find and replace.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "path": {
              "type": "string"
            },
            "props": {
              "anyOf": [
                {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 64,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "find": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "path"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "readwrite",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_add",
        "description": "Add or clone an element under a parent semantic path in an existing document. Supply type or internal DOM from path, optional before/after/index placement, and props.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "parent": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "props": {
              "anyOf": [
                {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 64,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "file",
            "parent"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "readwrite",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_remove",
        "description": "Remove an element at an exact semantic path. Destructive document edit: inspect with office_get before calling.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "path"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "readwrite",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_view",
        "description": "Get a bounded text, annotated, outline, stats or issues overview. Supports range, cols (xlsx), issueType filter and structured JSON output up to 500 rows/2000 cells.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "mode": {
              "type": "string",
              "enum": [
                "text",
                "annotated",
                "outline",
                "stats",
                "issues"
              ]
            },
            "range": {
              "type": "string"
            },
            "cols": {
              "type": "string"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "maxSheetRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "maxCells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "issueType": {
              "type": "string"
            },
            "json": {
              "type": "boolean"
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "read",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_batch",
        "description": "Apply 1–128 add, set, remove, move, swap, get, query or validate commands atomically to an existing document. Any failed item rolls back the batch.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "add"
                        ]
                      },
                      "parent": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "from": {
                        "type": "string"
                      },
                      "before": {
                        "type": "string"
                      },
                      "after": {
                        "type": "string"
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "props": {
                        "anyOf": [
                          {
                            "type": "object",
                            "minProperties": 1,
                            "maxProperties": 64,
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 64,
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "command",
                      "parent"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "set"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "props": {
                        "anyOf": [
                          {
                            "type": "object",
                            "minProperties": 1,
                            "maxProperties": 64,
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 64,
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "find": {
                        "type": "string"
                      },
                      "replace": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "command",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "remove"
                        ]
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "command",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "move"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "before": {
                        "type": "string"
                      },
                      "after": {
                        "type": "string"
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "props": {
                        "anyOf": [
                          {
                            "type": "object",
                            "minProperties": 1,
                            "maxProperties": 64,
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 64,
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "command",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "swap"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "path2": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "command",
                      "path",
                      "path2"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "get"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "depth": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      }
                    },
                    "required": [
                      "command",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "query"
                        ]
                      },
                      "selector": {
                        "type": "string"
                      },
                      "compact": {
                        "type": "boolean"
                      },
                      "fields": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "command",
                      "selector"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "validate"
                        ]
                      }
                    },
                    "required": [
                      "command"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "file",
            "commands"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "readwrite",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_preview",
        "description": "Render a single page or a 1–12 page thumbnail contact sheet (--grid) via sandboxed HTML rendering as PNG when image input is supported; otherwise return an outline.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "pages": {
              "type": "string",
              "description": "Contiguous range \"1-12\" (.docx/.pptx) or comma list \"1,3,5\" (.docx only); max 12 pages."
            },
            "grid": {
              "type": "string",
              "description": "Contact-sheet columns for .docx/.pptx: \"auto\" or \"1\"-\"6\". Defaults to \"auto\" when pages selects multiple pages."
            },
            "range": {
              "type": "string",
              "description": "Excel cell range (\"Sheet1!A1:H20\") or PPTX/DOCX element path (\"/slide[2]/table[1]\") crop."
            },
            "render": {
              "type": "string",
              "enum": [
                "html"
              ]
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "read",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_validate",
        "description": "Validate an existing .docx, .xlsx or .pptx against the OpenXML schema and return bounded structured findings, including invalid-document errors.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Workspace-relative path or explicitly approved absolute path (.docx/.xlsx/.pptx)."
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "read",
            "path": "$.file"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_help",
        "description": "Query pinned OfficeCLI schema reference for docx, xlsx or pptx elements and property names without opening a document file.",
        "parameters": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "docx",
                "xlsx",
                "pptx"
              ]
            },
            "verb": {
              "type": "string",
              "enum": [
                "add",
                "set",
                "get",
                "query",
                "remove"
              ]
            },
            "element": {
              "type": "string",
              "description": "Optional element token (e.g. paragraph, table-cell, equation, chart, chart-series, slide, shape)."
            }
          },
          "required": [
            "format"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "office_import",
        "description": "Import an existing local .csv or .tsv data file into a sheet of an existing .xlsx workbook without modifying the source file.",
        "parameters": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Target existing .xlsx workbook path (workspace-relative or approved absolute)."
            },
            "sheet": {
              "type": "string",
              "description": "Target sheet DOM path (e.g. \"/Sheet1\" or \"/Raw_Data\")."
            },
            "source": {
              "type": "string",
              "description": "Source existing .csv or .tsv file path (workspace-relative or approved absolute)."
            },
            "header": {
              "type": "boolean",
              "description": "Treat first row as header (adds AutoFilter and freeze pane)."
            },
            "startCell": {
              "type": "string",
              "description": "Top-left target cell (default \"A1\")."
            },
            "delimiter": {
              "type": "string",
              "description": "Optional single-character delimiter override (e.g. \";\", \"|\", \"\\t\")."
            },
            "decimal": {
              "type": "string",
              "enum": [
                ".",
                ","
              ],
              "description": "Decimal mark used in the source file."
            }
          },
          "required": [
            "file",
            "sheet",
            "source"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "file",
            "operation": "readwrite",
            "path": "$.file"
          },
          {
            "kind": "file",
            "operation": "read",
            "path": "$.source"
          },
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      }
    ]
  }
}
