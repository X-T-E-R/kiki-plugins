{
  "name": "kiki-bilibili",
  "version": "0.1.1",
  "description": "Discover, watch, comment, read messages and publish Bilibili videos through bili-agent.",
  "license": "MIT",
  "icon": "./icon.svg",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kiki Bilibili",
    "shortDescription": "Bilibili publishing and video understanding"
  },
  "x-kiki": {
    "engines": {
      "kiki": ">=0.4.1"
    },
    "entry": "./entry.mjs",
    "permissions": {
      "fs": "outside",
      "net": [
        "*.bilibili.com",
        "*.hdslb.com"
      ],
      "exec": [
        "bili",
        "ffmpeg"
      ]
    },
    "settings": {
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "properties": {
          "biliCliPath": {
            "type": "string",
            "title": "bili executable",
            "description": "Absolute bili executable from an isolated bili-agent==1.0.0 installation; defaults to bili on PATH.",
            "default": "bili"
          },
          "cliHome": {
            "type": "string",
            "title": "Bilibili profile directory",
            "description": "Required absolute directory for this account's bili-agent login and ASR configuration. No implicit home or browser credentials are used.",
            "default": ""
          },
          "ffmpegDir": {
            "type": "string",
            "title": "FFmpeg directory",
            "description": "Optional directory containing ffmpeg and ffprobe, added to this subprocess PATH.",
            "default": ""
          },
          "timeoutMs": {
            "type": "number",
            "default": 600000,
            "title": "CLI wait timeout (ms)",
            "description": "Whole milliseconds from 1000 to 2147483647. Invalid values are rejected before starting bili."
          }
        }
      }
    },
    "tools": [
      {
        "schemaVersion": 1,
        "name": "bilibili_discover",
        "description": "Search Bilibili videos or users, inspect hot searches, get personalized recommendations or read a following timeline. timeline uses next_offset as cursor; up optionally selects one creator.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "search",
                "users",
                "hot",
                "recommend",
                "timeline"
              ],
              "type": "string"
            },
            "keyword": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "type": "string",
              "enum": [
                "default",
                "views",
                "new",
                "danmaku",
                "favorites",
                "comments"
              ]
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "recommend: at most 30; search/hot/timeline: at most 50."
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "up": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "video",
                "article",
                "pgc"
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_watch",
        "description": "Read metadata, timestamped subtitles or ASR, and real video frames. all reads subtitles (falls back to ASR when absent), then frames. visual=frames uses FFmpeg on the video stream; preview is only a seek-bar thumbnail. ASR defaults to local; cloud uses the explicitly configured profile service. Frame paths and requested/actual seconds remain in the result.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "metadata",
                "subtitle",
                "transcribe",
                "visual",
                "all"
              ]
            },
            "video": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "visual": {
              "type": "string",
              "enum": [
                "frames",
                "preview"
              ],
              "default": "frames"
            },
            "timestamps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 6
            },
            "engine": {
              "type": "string",
              "enum": [
                "local",
                "cloud",
                "auto"
              ],
              "default": "local"
            },
            "maxMinutes": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 60
            },
            "includeComments": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "action",
            "video"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_interact",
        "description": "Read comments or replies, post with real @ mentions, like or favorite. check inspects the configured account’s recent comment lists (root: at most 3 pages; replies: 2); it cannot measure visibility to others. Use rootId for nested replies. resourceType defaults to video; other comment areas use numeric oid in video. Unknown writes are not repeated.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "comments",
                "replies",
                "check",
                "comment",
                "reply",
                "mention",
                "like",
                "favorite"
              ]
            },
            "video": {
              "type": "string",
              "minLength": 1
            },
            "resourceType": {
              "type": "string",
              "enum": [
                "video",
                "dynamic",
                "draw",
                "article"
              ],
              "default": "video"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "commentId": {
              "type": "integer",
              "minimum": 1
            },
            "rootId": {
              "type": "integer",
              "minimum": 1
            },
            "mentions": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "folder": {
              "type": "string",
              "minLength": 1
            },
            "undo": {
              "type": "boolean"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "sort": {
              "type": "string",
              "enum": [
                "hot",
                "time"
              ]
            }
          },
          "required": [
            "action",
            "video"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_inbox",
        "description": "Read replies, @ mentions, likes, system notices and private messages. notifications reads unread counts only. inbox reads all new categories and marks notifications read (limit per category, max 20). Category reads can also acknowledge notifications. replies/mentions/likes accept next_cursor. DM list/read leave unread state unchanged; mark_read acknowledges the returned sequence. Unknown acknowledgements are not retried.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "notifications",
                "inbox",
                "replies",
                "mentions",
                "likes",
                "system",
                "list",
                "read",
                "mark_read"
              ]
            },
            "threadId": {
              "type": "string",
              "minLength": 1
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "inbox: at most 20 per category; other actions: at most 50."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_publish",
        "description": "Submit one or multiple workspace-local videos with the mature bili-agent VideoUploader, or inspect a submitted archive. submit performs upload and publication in one call; defaults to the AI-content declaration. Unknown outcomes require platform inspection before another submit. Files and symlink targets must be inside the workspace.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "submit",
                "status"
              ]
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "cover": {
              "type": "string",
              "minLength": 1,
              "description": "Optional workspace-local cover image; otherwise the CLI extracts one with FFmpeg."
            },
            "bvid": {
              "type": "string",
              "minLength": 1
            },
            "tid": {
              "type": "integer",
              "minimum": 1
            },
            "zone": {
              "type": "integer",
              "minimum": 1
            },
            "schedule": {
              "type": "string",
              "minLength": 1,
              "description": "ISO datetime; platform accepts 2 hours to 15 days ahead."
            },
            "private": {
              "type": "boolean",
              "default": false
            },
            "aiDeclare": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_account",
        "description": "Manage the explicitly configured bili-agent profile. login returns a QR image for the human; status polls that login or validates/refreshes its credentials. logout removes only that profile login. asr_status inspects ASR configuration. Does not import browser cookies or use an implicit user home.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "login",
                "status",
                "logout",
                "asr_status"
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_diagnose",
        "description": "Check the installed bili-agent version and ASR dependencies in the explicit profile. Requires bili-agent 1.0.0. No login or external write is started.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      }
    ]
  }
}
