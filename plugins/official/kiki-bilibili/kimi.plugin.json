{
  "name": "kiki-bilibili",
  "version": "0.2.0",
  "description": "Discover, watch, comment, read messages and publish Bilibili videos through bili-agent.",
  "license": "MIT",
  "icon": "./icon.svg",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kiki Bilibili",
    "shortDescription": "Bilibili publishing and video understanding"
  },
  "x-kiki": {
    "engines": {
      "kiki": ">=0.4.1"
    },
    "entry": "./entry.mjs",
    "permissions": {
      "fs": "outside",
      "net": [
        "*.bilibili.com",
        "*.hdslb.com"
      ],
      "exec": [
        "bili",
        "python",
        "ffmpeg"
      ]
    },
    "settings": {
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "properties": {
          "biliCliPath": {
            "type": "string",
            "title": "bili executable",
            "description": "Absolute bili executable from an isolated bili-agent==1.0.0 installation; defaults to bili on PATH.",
            "default": "bili"
          },
          "cliHome": {
            "type": "string",
            "title": "Bilibili profile directory",
            "description": "Explicit absolute directory for the default bili-agent login and ASR configuration. Required unless profiles is set; no implicit home or browser credentials are used.",
            "default": ""
          },
          "profiles": {
            "type": "string",
            "title": "Named account profiles (JSON or name=path lines)",
            "description": "Optional map of profile alias to explicit absolute bili-agent home directory, e.g. {\"nia\":\"C:\\\\...\\\\bili-nia-home\",\"main\":\"C:\\\\...\\\\bili-main-home\"}.",
            "default": "",
            "multiline": true,
            "advanced": true
          },
          "defaultProfile": {
            "type": "string",
            "title": "Default profile name",
            "description": "Optional default key in profiles when tool args omit profile; falls back to cliHome.",
            "default": "",
            "advanced": true
          },
          "ffmpegDir": {
            "type": "string",
            "title": "FFmpeg directory",
            "description": "Optional directory containing ffmpeg and ffprobe, added to this subprocess PATH.",
            "default": ""
          },
          "timeoutMs": {
            "type": "number",
            "default": 600000,
            "title": "CLI wait timeout (ms)",
            "description": "Whole milliseconds from 1000 to 2147483647. Invalid values are rejected before starting bili."
          }
        }
      }
    },
    "tools": [
      {
        "schemaVersion": 1,
        "name": "bilibili_discover",
        "description": "Search Bilibili videos or users, inspect UP profiles and video lists (user_info/user_videos), read hot searches/popular/weekly/precious/rank, get personalized recommendations or read a following timeline. unseen skips videos already watched in the selected profile.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "search",
                "users",
                "user_info",
                "user_videos",
                "hot",
                "popular",
                "weekly",
                "precious",
                "rank",
                "recommend",
                "timeline"
              ],
              "type": "string"
            },
            "keyword": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "type": "string",
              "enum": [
                "default",
                "views",
                "new",
                "danmaku",
                "favorites",
                "comments"
              ]
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "recommend: at most 30; search/user_videos/hot/popular/rank/timeline: at most 50."
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "up": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "video",
                "article",
                "pgc"
              ]
            },
            "zone": {
              "type": "string",
              "enum": [
                "all",
                "anime",
                "music",
                "dance",
                "game",
                "knowledge",
                "tech",
                "sports",
                "car",
                "life",
                "food",
                "animal",
                "kichiku",
                "fashion",
                "ent",
                "film",
                "original",
                "rookie"
              ]
            },
            "issue": {
              "type": "integer",
              "minimum": 1
            },
            "unseen": {
              "type": "boolean",
              "default": false
            },
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_watch",
        "description": "Read metadata, digest (token-efficient one-call summary + capped transcript + chapters + hot comments + contact sheet), summary, chapters, danmaku, timestamped subtitles/ASR, or real frames. textOnly returns plain joined text to save tokens; frames=0 skips sheet extraction.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "metadata",
                "digest",
                "summary",
                "chapters",
                "danmaku",
                "subtitle",
                "transcribe",
                "visual",
                "all"
              ]
            },
            "video": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "visual": {
              "type": "string",
              "enum": [
                "frames",
                "preview"
              ],
              "default": "frames"
            },
            "timestamps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 6
            },
            "frames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "default": 9
            },
            "comments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 5
            },
            "transcript": {
              "type": "string",
              "enum": [
                "auto",
                "subtitle",
                "none"
              ],
              "default": "auto"
            },
            "maxChars": {
              "type": "integer",
              "minimum": 0,
              "default": 6000
            },
            "textOnly": {
              "type": "boolean",
              "default": false
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 200
            },
            "record": {
              "type": "boolean",
              "default": false
            },
            "engine": {
              "type": "string",
              "enum": [
                "local",
                "cloud",
                "auto"
              ],
              "default": "local"
            },
            "maxMinutes": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 60
            },
            "includeComments": {
              "type": "boolean",
              "default": false
            },
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [
            "action",
            "video"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_interact",
        "description": "Read comments (unreplied/supporters filter on page) or replies, post with real @ mentions, send danmaku, like or favorite. check inspects the configured account’s recent comment lists (root: at most 3 pages; replies: 2); it cannot measure visibility to others.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "comments",
                "replies",
                "check",
                "comment",
                "reply",
                "mention",
                "danmaku",
                "like",
                "favorite"
              ]
            },
            "video": {
              "type": "string",
              "minLength": 1
            },
            "resourceType": {
              "type": "string",
              "enum": [
                "video",
                "dynamic",
                "draw",
                "article"
              ],
              "default": "video"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "commentId": {
              "type": "integer",
              "minimum": 1
            },
            "rootId": {
              "type": "integer",
              "minimum": 1
            },
            "mentions": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "folder": {
              "type": "string",
              "minLength": 1
            },
            "undo": {
              "type": "boolean"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "sort": {
              "type": "string",
              "enum": [
                "hot",
                "time"
              ]
            },
            "unreplied": {
              "type": "boolean",
              "default": false
            },
            "supporters": {
              "type": "boolean",
              "default": false
            },
            "time": {
              "type": "number",
              "minimum": 0,
              "description": "Danmaku timestamp in seconds."
            },
            "danmakuMode": {
              "type": "string",
              "enum": [
                "scroll",
                "top",
                "bottom"
              ],
              "default": "scroll"
            },
            "color": {
              "type": "string",
              "pattern": "^#?[0-9a-fA-F]{6}$"
            },
            "expectedMid": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional safety lock: require logged-in UID to match before any write."
            },
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [
            "action",
            "video"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_inbox",
        "description": "Read replies, @ mentions, likes, system notices and private messages. notifications reads unread counts only. inbox reads all new categories and marks notifications read (limit per category, max 20). Category reads can also acknowledge notifications. replies/mentions/likes accept next_cursor. DM list/read leave unread state unchanged; mark_read acknowledges the returned sequence. Unknown acknowledgements are not retried.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "notifications",
                "inbox",
                "replies",
                "mentions",
                "likes",
                "system",
                "list",
                "read",
                "mark_read"
              ]
            },
            "threadId": {
              "type": "string",
              "minLength": 1
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "inbox: at most 20 per category; other actions: at most 50."
            },
            "expectedMid": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional safety lock: require logged-in UID to match before any write."
            },
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_publish",
        "description": "Publish and manage creator works: submit/edit workspace-local videos, inspect archive status/list/stats/zones, manage chapters, post/list/delete dynamics (with images or votes), and manage seasons. submit defaults to AI-content declaration; unknown write outcomes are never retried.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "submit",
                "status",
                "list",
                "stats",
                "zones",
                "edit",
                "chapters_show",
                "chapters_set",
                "chapters_clear",
                "dynamic_post",
                "dynamic_list",
                "dynamic_delete",
                "dynamic_vote",
                "season_list",
                "season_create",
                "season_add"
              ]
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "video": {
              "type": "string",
              "minLength": 1,
              "description": "Workspace-local replacement video file for edit (single-P archive)."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "cover": {
              "type": "string",
              "minLength": 1,
              "description": "Optional workspace-local cover image (required for season_create)."
            },
            "cover43": {
              "type": "string",
              "minLength": 1,
              "description": "Optional workspace-local 4:3 mobile cover image for submit or edit."
            },
            "bvid": {
              "type": "string",
              "minLength": 1
            },
            "videos": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Own video BV/av IDs to append for season_add."
            },
            "tid": {
              "type": "integer",
              "minimum": 1
            },
            "zone": {
              "type": "integer",
              "minimum": 1
            },
            "schedule": {
              "type": "string",
              "minLength": 1,
              "description": "ISO datetime; platform accepts 2 hours to 15 days ahead."
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "description": "Topic name/ID for submit, or numeric topic ID for dynamic_post."
            },
            "season": {
              "type": "integer",
              "minimum": 1,
              "description": "Season ID for submit or season_add."
            },
            "section": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional section ID within a season for season_add."
            },
            "dynamicText": {
              "type": "string",
              "maxLength": 233,
              "description": "Companion fan dynamic text on submit (max 233 chars)."
            },
            "noReprint": {
              "type": "boolean",
              "default": false
            },
            "private": {
              "type": "boolean",
              "default": false
            },
            "aiDeclare": {
              "type": "boolean",
              "description": "AI-content declaration (defaults to true on submit; omitted on edit preserves current setting)."
            },
            "uploadStatus": {
              "type": "string",
              "enum": [
                "all",
                "published",
                "reviewing",
                "rejected"
              ],
              "default": "all"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "chapters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Chapters formatted as \"MM:SS Title\" (first at 0:00) for chapters_set."
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Dynamic body text for dynamic_post."
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Workspace-local images (up to 9) for dynamic_post."
            },
            "mentions": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "voteTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "voteOptions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "voteMulti": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 1
            },
            "voteDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 7
            },
            "dynamicId": {
              "type": "string",
              "minLength": 1
            },
            "voteId": {
              "type": "integer",
              "minimum": 1
            },
            "up": {
              "type": "string",
              "minLength": 1,
              "description": "Numeric UID for dynamic_list (defaults to own account)."
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "expectedMid": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional safety lock: require logged-in UID to match before any write."
            },
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_account",
        "description": "Manage explicitly configured bili-agent profiles: login/status/logout (with optional waitSeconds), profiles (list all configured profiles and login states), profile, stats (creator center analytics), following, set_avatar, set_sign, set_name, or asr_status. Never imports browser cookies.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "login",
                "status",
                "logout",
                "profile",
                "profiles",
                "stats",
                "following",
                "set_avatar",
                "set_sign",
                "set_name",
                "asr_status"
              ]
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "description": "Workspace-local image path for set_avatar."
            },
            "sign": {
              "type": "string",
              "maxLength": 70,
              "description": "New profile signature for set_sign."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "New nickname for set_name."
            },
            "allowCost": {
              "type": "boolean",
              "default": false
            },
            "waitSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180,
              "default": 0,
              "description": "Optional QR scan wait seconds for login or status (0 returns immediately)."
            },
            "period": {
              "type": "string",
              "enum": [
                "yesterday",
                "week",
                "month",
                "3months"
              ],
              "default": "week"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "expectedMid": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional safety lock: require logged-in UID to match before any write."
            },
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "bilibili_diagnose",
        "description": "Check the installed bili-agent version and ASR dependencies in the selected explicit profile. Requires bili-agent 1.0.0. No login or external write is started.",
        "parameters": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "description": "Optional named account profile from plugin settings (e.g. nia or main)."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional brief note on why this tool is being called (ignored at runtime)."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "accesses": [
          {
            "kind": "all"
          }
        ],
        "disclosure": "deferred"
      }
    ]
  }
}
