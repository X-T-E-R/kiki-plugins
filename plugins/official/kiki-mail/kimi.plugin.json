{
  "name": "kiki-mail",
  "version": "0.3.0",
  "description": "Search archived mail across sources in Open Archiver, or read and send through direct IMAP and SMTP accounts.",
  "license": "MIT",
  "icon": "./icon.svg",
  "skills": "./skills/",
  "interface": {
    "displayName": "Mail",
    "shortDescription": "Archive search and direct IMAP / SMTP mail",
    "localization": {
      "zh-CN": {
        "displayName": "邮件",
        "shortDescription": "搜索归档邮件，也可通过 IMAP / SMTP 收发邮件"
      }
    }
  },
  "x-kiki": {
    "engines": { "kiki": ">=0.4.1" },
    "entry": "./entry.mjs",
    "activation": "app",
    "permissions": { "fs": "outside", "net": ["*"], "secrets": true, "uiPanel": true },
    "panels": [{
      "schemaVersion": 1,
      "id": "mail",
      "label": "Mail",
      "slot": "workspace",
      "path": "./panel.html"
    }],
    "settings": {
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "string",
            "title": "在 Mail 面板里管理账号",
            "description": "账号由 Mail 面板管理，请勿在此编辑。",
            "hidden": true
          },
          "credentials": {
            "type": "string",
            "title": "在 Mail 面板里管理账号",
            "description": "凭据只在 Mail 面板填写，保存后不回显。",
            "secret": true,
            "hidden": true
          },
          "oauthDefaults": {
            "type": "string",
            "title": "在 Mail 面板里管理账号",
            "description": "Gmail 与 Outlook 的项目 OAuth 应用在 Mail 面板配置一次。不要在这里编辑 JSON。",
            "secret": true,
            "hidden": true
          },
          "defaultAccountId": { "type": "string", "hidden": true, "title": "在 Mail 面板里管理默认发件账号" },
          "defaultReadAccountId": { "type": "string", "hidden": true, "title": "在 Mail 面板里管理默认阅读账号" },
          "accountStatus": { "type": "string", "hidden": true, "title": "在 Mail 面板查看连接测试" },
          "watchEnabled": {
            "type": "boolean",
            "title": "Watch inboxes while Kiki is open",
            "description": "全局开关，作用于所有已开启监听的邮箱。账号订阅、转发和超时在 Mail 面板里按作用域设置。",
            "default": false
          }
        }
      }
    },
    "tools": [
      {
        "schemaVersion": 1,
        "name": "MailAccount",
        "description": "List, show, save, delete or test configured mail accounts, or list provider presets. List shows account capabilities, the default reader and the independent default SMTP sender. Set credentials in the Mail panel, never in chat. A connection test does not send mail or grant OAuth consent.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": { "type": "string", "enum": ["list", "show", "save", "delete", "test", "presets"] },
            "accountId": { "type": "string" },
            "watchEnabled": { "type": "boolean" },
            "account": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "note": { "type": "string", "maxLength": 200 },
                "imapId": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
                "folders": { "type": "object", "additionalProperties": false, "properties": { "sent": { "type": "string" }, "drafts": { "type": "string" }, "trash": { "type": "string" }, "archive": { "type": "string" } } },
                "headers": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": "string" }, "description": "Non-secret outgoing X- message headers only." },
                "hooks": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "properties": { "event": { "type": "string", "enum": ["beforeConnect", "afterSend"] }, "action": { "type": "string", "enum": ["setTimeout", "recordEvent"] }, "value": { "type": ["string", "integer"] } }, "required": ["event", "action", "value"] } },
                "user": { "type": "string" },
                "from": { "type": "string" },
                "auth": { "type": "string", "enum": ["password", "oauth2", "apiKey"] },
                "preset": { "type": "string" },
                "baseUrl": { "type": "string", "description": "Open Archiver HTTPS service URL, without credentials." },
                "sendOnly": { "type": "boolean", "description": "For direct accounts: keep SMTP and suspend direct reading and inbox watch." },
                "imapHost": { "type": "string" },
                "imapPort": { "type": "integer" },
                "imapSecure": { "type": "boolean" },
                "smtpHost": { "type": "string" },
                "smtpPort": { "type": "integer" },
                "smtpSecure": { "type": "boolean" },
                "allowInsecureAuth": { "type": "boolean" },
                "watch": { "type": "boolean" },
                "imEnabled": { "type": "boolean" },
                "imChannelId": { "type": "string" },
                "imRouteRevision": { "type": "string" },
                "imPreview": { "type": "boolean" },
                "oauthClientId": { "type": "string" },
                "oauthTokenUrl": { "type": "string" },
                "oauthScope": { "type": "string" },
                "timeoutMs": { "type": "integer" }
              }
            }
          },
          "required": ["action"]
        },
        "accesses": [{ "kind": "all" }],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "Mailbox",
        "description": "Search, read or save an attachment. Omit accountId to use the default reader for search or listing. Open Archiver searches across sources: use sources to list them, sourceIds and mailboxes to filter, and reuse the hit's accountId and archiveId for read, plus attachmentId to save. Direct IMAP uses folders, mailbox, uidValidity, uid and partId. Reuse nextCursor with the same filters. Full bodies and attachments may be returned as local paths.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": { "type": "string", "enum": ["folders", "sources", "search", "read", "attachment"] },
            "accountId": { "type": "string" },
            "mailbox": { "type": "string", "description": "Direct IMAP folder, not an archive mailbox-owner address." },
            "query": { "type": "string" },
            "from": { "type": "string" },
            "unseen": { "type": "boolean", "description": "Direct IMAP only." },
            "since": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "cursor": { "type": "string" },
            "uidValidity": { "type": "string" },
            "uid": { "type": "string" },
            "partId": { "type": "string" },
            "archiveId": { "type": "string", "description": "Open Archiver message ID returned by search." },
            "attachmentId": { "type": "string", "description": "Open Archiver attachment identifier returned by read." },
            "sourceIds": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
            "mailboxes": { "type": "array", "maxItems": 100, "items": { "type": "string" }, "description": "Open Archiver mailbox-owner addresses, not IMAP folders." }
          },
          "required": ["action"]
        },
        "accesses": [{ "kind": "all" }],
        "disclosure": "deferred"
      },
      {
        "schemaVersion": 1,
        "name": "MailSend",
        "description": "Send a new message or reply to one identified message through the account's SMTP server. accepted means the SMTP server accepted those recipients, not that the message was delivered. If the connection stops or the send is cancelled after the message data is written, the outcome is uncertain and that account and requestId is not sent again. confirmResend does not repeat it. A definite failure before the data was submitted can be retried. Do not pass passwords.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": { "type": "string", "enum": ["send", "reply"] },
            "accountId": { "type": "string" },
            "to": { "type": "string" },
            "cc": { "type": "string" },
            "bcc": { "type": "string" },
            "subject": { "type": "string" },
            "text": { "type": "string" },
            "html": { "type": "string" },
            "mailbox": { "type": "string" },
            "uidValidity": { "type": "string" },
            "uid": { "type": "string" },
            "requestId": { "type": "string" },
            "confirmResend": { "type": "boolean" },
            "attachmentPaths": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
          },
          "required": ["action", "accountId"]
        },
        "accesses": [{ "kind": "all" }],
        "disclosure": "deferred"
      }
    ]
  }
}
